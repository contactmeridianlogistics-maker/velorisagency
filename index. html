<script>
(function(){
var rm=matchMedia('(prefers-reduced-motion: reduce)').matches;
/* nav pill */
var nav=document.getElementById('nav'),pill=nav.querySelector('i'),links=[].slice.call(nav.querySelectorAll('a'));
function mv(a){pill.style.left=a.offsetLeft+'px';pill.style.width=a.offsetWidth+'px'}
function act(){return nav.querySelector('a.on')}
links.forEach(function(a){a.addEventListener('mouseenter',function(){mv(a)});a.addEventListener('focus',function(){mv(a)});a.addEventListener('click',function(){links.forEach(function(l){l.classList.remove('on')});a.classList.add('on')})});
nav.addEventListener('mouseleave',function(){mv(act())});
function init(){mv(act())}if(document.fonts&&document.fonts.ready)document.fonts.ready.then(init);init();addEventListener('resize',init);
/* cursor reveal */
var art=document.getElementById('art'),rev=document.getElementById('rev'),hero=document.querySelector('.hero');
var cx=0,cy=0,tx=0,ty=0,r=0,tr=0;
hero.addEventListener('mousemove',function(e){var b=art.getBoundingClientRect();tx=e.clientX-b.left;ty=e.clientY-b.top;tr=in_(e)?200:0});
hero.addEventListener('mouseleave',function(){tr=0});
function in_(e){var b=art.getBoundingClientRect();return e.clientX>b.left&&e.clientX<b.right&&e.clientY>b.top&&e.clientY<b.bottom}
(function loop(){cx+=(tx-cx)*.14;cy+=(ty-cy)*.14;r+=(tr-r)*.1;rev.style.setProperty('--x',cx+'px');rev.style.setProperty('--y',cy+'px');rev.style.setProperty('--r',r+'px');requestAnimationFrame(loop)})();
/* count up */
function count(el,to,d,suf){if(rm){el.textContent=to+(suf||'');return}var t0=performance.now();(function f(t){var p=Math.min(1,(t-t0)/d);el.textContent=Math.round(to*(1-Math.pow(1-p,3)))+(suf||'');if(p<1)requestAnimationFrame(f)})(t0)}
document.querySelectorAll('[data-count]').forEach(function(el){count(el,+el.dataset.count,1400)});
/* statement words */
var h=document.getElementById('stmt'),words=h.textContent.trim().split(/\s+/);
h.innerHTML=words.map(function(w){return '<span>'+w+'</span>'}).join(' ');
var sp=[].slice.call(h.children);
function fill(){var b=h.getBoundingClientRect(),vh=innerHeight;var p=(vh*.85-b.top)/(b.height+vh*.35);p=Math.max(0,Math.min(1,p));var n=p*(sp.length+3);sp.forEach(function(s,i){s.classList.toggle('on',i<n-1.5)})}
/* parallax + cards */
var imgs=art;function sc(){if(!rm)imgs.style.translate='0 '+Math.min(scrollY*.12,70)+'px';fill()}
addEventListener('scroll',sc,{passive:true});sc();
var cards=[].slice.call(document.querySelectorAll('.sc'));
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){cards.forEach(function(c,i){setTimeout(function(){c.classList.add('in')},rm?0:i*120)});io.disconnect()}})},{threshold:.25});
io.observe(document.getElementById('cards'));
if(rm)cards.forEach(function(c){c.classList.add('in')});
var f=document.getElementById('cf');f.addEventListener('submit',function(e){e.preventDefault();var d=new FormData(f);location.href='mailto:hola@veloris.agency?subject='+encodeURIComponent('Proyecto: '+d.get('s'))+'&body='+encodeURIComponent(d.get('m')+'\n\n'+d.get('n')+' · '+d.get('e')+' · '+d.get('t'))});
})();
</script>
